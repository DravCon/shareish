# API (optional)
# API_V1_PREFIX=/api/v1

# Database: SQLite (default) or Postgres
# DATABASE_URL=sqlite:///./shareish.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/shareish

# JWT secret for sessions (change in production)
# JWT_SECRET=change-me-in-production-use-long-random-string

# Firebase project ID (optional; for strict token verification)
# FIREBASE_PROJECT_ID=your-project-id

# Anthropic API key (required for AI item identification)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Upload directory for images (optional)
# UPLOAD_DIR=./uploads

# Public origin for absolute image URLs (set in production so images load reliably)
# PUBLIC_ORIGIN=https://shareish-production.up.railway.app

# Optional: S3 or R2 for persistent image storage (images survive redeploys)
# Set these to use S3/R2 instead of local disk for uploads.
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# For Cloudflare R2, also set: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
